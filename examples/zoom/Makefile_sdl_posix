#################################################################################
# Tornado root directory
#################################################################################
TORNADO_BASE = ../../

#################################################################################
# Your demo code comes here
#################################################################################
LOCAL_INCDIR  = ./src

#Demo objects
DEMO_OBJS += demo.o

# Zoom
DEMO_OBJS += zoom/zoom.o
DEMO_OBJS += zoom/zoom_util.o

# Run the Amiga inner loop (zoom_inner.s) in the emulated 68k instead of
# renderZoomC(). Needs a Musashi checkout, see manual/Emulated68k.md.
# Build with TORNADO_68K_EMU=false to use the C version.
TORNADO_68K_EMU ?= true
ifeq ($(TORNADO_68K_EMU),true)
DEMO_68K_OBJS += zoom/amiga/zoom_inner.o
DEMO_OBJS += zoom/zoom_68k.o
endif

# Save all object and source files to tmp.
BUILDDIR = /tmp/build-posix

CCFLAGS += -D__DEBUG_CODE

# Tndo malloc debug.
#CCFLAGS += -DTNDO_MEMORY_DEBUG

TARGET = ./zoom.elf

#################################################################################
# Do NOT add anything below this line!!!
#################################################################################
include $(TORNADO_BASE)/tornado_sdl_posix.mk
